<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;netstandard2.0</TargetFrameworks>
    <ProjectGuid>{1FC8EA20-3665-4E67-82F3-FE4FD3F37758}</ProjectGuid>
    <RootNamespace>SoftFX.Lrp</RootNamespace>
    <AssemblyName>FDK.Lrp</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Resources\FDK.snk</AssemblyOriginatorKeyFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <Prefer32Bit>false</Prefer32Bit>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <!-- net48 flavor must keep its legacy output path (..\Debug\, ..\Release\);
         the netstandard2.0 flavor overrides OutputPath below. The TFM suffix is
         added to the intermediate path manually instead, so obj\ stays per-TFM. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != ''">
    <IntermediateOutputPath>obj\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>..\Debug\</OutputPath>
    <DocumentationFile>..\Debug\FDK.Lrp.xml</DocumentationFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>..\Release\</OutputPath>
    <DocumentationFile>..\Release\FDK.Lrp.xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <OutputPath>..\$(Configuration)\netstandard2.0\</OutputPath>
    <DocumentationFile>..\$(Configuration)\netstandard2.0\FDK.Lrp.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Diagnostics.Process" Version="4.3.0" />
  </ItemGroup>

  <Target Name="PostBuildNet48" Condition="'$(TargetFramework)' == 'net48'" AfterTargets="Build">
    <Exec Command="if not exist ..\dll\ (md ..\dll\)&#10;xcopy /Y &quot;$(TargetPath)&quot; ..\dll\&#10;if exist &quot;$(TargetDir)$(TargetName).xml&quot; (xcopy /Y &quot;$(TargetDir)$(TargetName).xml&quot; ..\dll\)&#10;if exist &quot;$(TargetDir)$(TargetName).pdb&quot; (xcopy /Y &quot;$(TargetDir)$(TargetName).pdb&quot; ..\dll\)" />
  </Target>
  <Target Name="PostBuildNetStandard" Condition="'$(TargetFramework)' == 'netstandard2.0'" AfterTargets="Build">
    <Exec Command="if not exist ..\dll\netstandard2.0\ (md ..\dll\netstandard2.0\)&#10;xcopy /Y &quot;$(TargetPath)&quot; ..\dll\netstandard2.0\&#10;if exist &quot;$(TargetDir)$(TargetName).xml&quot; (xcopy /Y &quot;$(TargetDir)$(TargetName).xml&quot; ..\dll\netstandard2.0\)&#10;if not exist ..\..\External\Dll\netstandard2.0\ (md ..\..\External\Dll\netstandard2.0\)&#10;xcopy /Y &quot;$(TargetPath)&quot; ..\..\External\Dll\netstandard2.0\&#10;if exist &quot;$(TargetDir)$(TargetName).xml&quot; (xcopy /Y &quot;$(TargetDir)$(TargetName).xml&quot; ..\..\External\Dll\netstandard2.0\)" />
  </Target>

</Project>
