<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;netstandard2.0</TargetFrameworks>
    <ProjectGuid>{D15BBA76-552E-4C6D-AE64-FD6F30CCF770}</ProjectGuid>
    <RootNamespace>SoftFX.Extended</RootNamespace>
    <AssemblyName>SoftFX.Extended.Net</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Resources\FDK.snk</AssemblyOriginatorKeyFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <Prefer32Bit>false</Prefer32Bit>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <!-- net48 flavor must keep its legacy output path (..\Debug\, ..\Release\);
         the netstandard2.0 flavor overrides OutputPath below. The TFM suffix is
         added to the intermediate path manually instead, so obj\ stays per-TFM. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != ''">
    <IntermediateOutputPath>obj\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
  </PropertyGroup>

  <!-- SDK adds DEBUG;TRACE / TRACE itself; _DEBUG is the legacy extra symbol. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>..\Debug\</OutputPath>
    <DefineConstants>_DEBUG</DefineConstants>
    <DocumentationFile>..\Debug\SoftFX.Extended.Net.xml</DocumentationFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>..\Release\</OutputPath>
    <DocumentationFile>..\Release\SoftFX.Extended.Net.xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <OutputPath>..\$(Configuration)\netstandard2.0\</OutputPath>
    <DocumentationFile>..\$(Configuration)\netstandard2.0\SoftFX.Extended.Net.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="FDK.Lrp">
      <HintPath>..\..\External\Dll\FDK.Lrp.dll</HintPath>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Management" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="TickTrader.BusinessLogic">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\..\External\Assembly\TickTrader.BusinessLogic.dll</HintPath>
    </Reference>
    <Reference Include="TickTrader.BusinessObjects">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\..\External\Assembly\TickTrader.BusinessObjects.dll</HintPath>
    </Reference>
    <Reference Include="TickTrader.Common">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\..\External\Assembly\TickTrader.Common.dll</HintPath>
    </Reference>
    <Reference Include="TickTrader.Server.Monitoring">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\..\External\Assembly\TickTrader.Server.Monitoring.dll</HintPath>
    </Reference>
    <Reference Include="TickTrader.Server.QuoteHistory">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\..\External\Assembly\TickTrader.Server.QuoteHistory.dll</HintPath>
    </Reference>
    <Reference Include="TickTrader.Server.QuoteHistory.Store.Ntfs">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\..\External\Assembly\TickTrader.Server.QuoteHistory.Store.Ntfs.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Reference Include="FDK.Lrp">
      <HintPath>..\..\External\Dll\netstandard2.0\FDK.Lrp.dll</HintPath>
    </Reference>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="4.7.1" />
  </ItemGroup>

  <!-- netstandard2.0 is connectivity-only: the Storage subsystem and the
       financial calculator engine depend on net48-only TickTrader.* assemblies
       and are excluded. Generated\ code is never excluded. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Remove="Storage\**\*.cs" />
    <Compile Remove="Financial\State\*.cs" />
    <Compile Remove="Financial\Adapter\*.cs" />
    <Compile Remove="Financial\FinancialCalculator.cs" />
    <Compile Remove="Financial\Rounding\FinancialRounding.cs" />
    <Compile Remove="Financial\Entries\AccountEntry.cs" />
    <Compile Remove="Financial\Entries\CurrencyEntry.cs" />
    <Compile Remove="Financial\Entries\SymbolEntry.cs" />
    <Compile Remove="Financial\Entries\TradeEntry.cs" />
    <Compile Remove="Financial\Entries\Asset.cs" />
    <Compile Remove="Financial\Collections\CurrencyEntries.cs" />
    <Compile Remove="Financial\Collections\SymbolEntries.cs" />
    <Compile Remove="Extensions\FinancialCalculatorExtensions.cs" />
  </ItemGroup>

  <!-- Legacy PreBuildEvent: regenerate LRP client code and rebuild the module
       archives embedded via EmbeddedModules.resx. net48 pass only, so it runs
       exactly once per build (net48 is first in TargetFrameworks, hence the
       archives are fresh before the netstandard pass embeds them). -->
  <Target Name="PreBuildNet48" Condition="'$(TargetFramework)' == 'net48'" BeforeTargets="PreBuildEvent">
    <Exec Command="&quot;$(SolutionDir)\..\External\bin\lrp.exe&quot; &quot;$(SolutionDir)FDK.xml&quot; &quot;$(ProjectDir)Generated&quot; /language:C# /side:client /mode:local /namespace:SoftFX.Extended.Generated&#10;&quot;$(SolutionDir)\..\External\bin\lrp.exe&quot; &quot;$(SolutionDir)LlCommon.xml&quot; &quot;$(ProjectDir)Financial\Generated&quot; /language:C# /side:client /mode:local /namespace:SoftFX.Extended.Financial.Generated&#10;&#10;..\..\Tools\7z\7z a -r ..\..\External\Archives\AnyCPU.zip ..\..\External\Assembly\*.dll&#10;..\..\Tools\7z\7z a ..\..\External\Archives\AnyCPU.zip ..\..\External\Dll\FDK.Lrp.dll&#10;..\..\Tools\7z\7z a ..\..\External\Archives\x32.zip ..\..\External\Dll\FDK.LRP.x86.dll&#10;..\..\Tools\7z\7z a ..\..\External\Archives\x64.zip ..\..\External\Dll\FDK.LRP.x64.dll&#10;..\..\Tools\7z\7z a ..\..\External\Archives\x32.zip ..\..\External\Dll\libeay32.dll&#10;..\..\Tools\7z\7z a ..\..\External\Archives\x64.zip ..\..\External\Dll\libeay64.dll&#10;..\..\Tools\7z\7z a ..\..\External\Archives\x32.zip ..\..\External\Dll\ssleay32.dll&#10;..\..\Tools\7z\7z a ..\..\External\Archives\x64.zip ..\..\External\Dll\ssleay64.dll&#10;..\..\Tools\7z\7z a -r ..\..\External\Archives\x32.zip ..\..\External\Dll\x86\*.dll&#10;..\..\Tools\7z\7z a -r ..\..\External\Archives\x64.zip ..\..\External\Dll\x64\*.dll&#10;..\..\Tools\7z\7z a -r ..\..\External\Archives\AnyCPU.zip ..\..\External\Exe\*.exe" />
  </Target>

  <!-- Legacy PostBuildEvent (net48 only): populate the FRE\ drop folder. -->
  <Target Name="PostBuildNet48" Condition="'$(TargetFramework)' == 'net48'" AfterTargets="Build">
    <Exec Command="if not exist &quot;$(SolutionDir)\..\FRE\&quot; (md &quot;$(SolutionDir)\..\FRE\&quot;)&#10;copy /Y &quot;$(TargetPath)&quot; &quot;$(SolutionDir)\..\FRE\&quot;&#10;copy /Y &quot;$(TargetDir)$(TargetName).xml&quot; &quot;$(SolutionDir)\..\FRE\&quot;&#10;copy /Y &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;$(SolutionDir)\..\FRE\&quot;&#10;xcopy /Y /S &quot;$(SolutionDir)\..\External\Assembly\*&quot; &quot;$(SolutionDir)\..\FRE\&quot;" />
  </Target>

</Project>
